{
  "name": "trafficmap",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "description": "TrafficMap passive TCP and UDP traffic dashboard with per-client filters.",
  "scripts": {
    "start": "node src/agent.js",
    "check": "node scripts/check-syntax.js",
