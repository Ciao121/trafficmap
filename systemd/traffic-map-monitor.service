[Unit]
Description=Passive Traffic Map Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trafficmap
Group=trafficmap
WorkingDirectory=/opt/traffic-map-monitor
Environment=NODE_ENV=production
Environment=TRAFFIC_MAP_CONFIG=/opt/traffic-map-monitor/config.json
ExecStart=/usr/bin/node /opt/traffic-map-monitor/src/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/traffic-map-monitor/data
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
